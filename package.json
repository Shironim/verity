{
  "name": "@dimassetoid/verity",
  "version": "0.1.0",
  "description": "Multi-language spec-drift detector based on git provenance and normalized AST fingerprinting",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "verity": "dist/verity.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shironim/verity.git"
  },
  "type": "module",
  "author": "Dimas Seto",
  "license": "MIT",
  "keywords": [
    "spec-drift",
    "git-provenance",
    "ast-fingerprint",
    "mcp",
    "model-context-protocol",
    "vue-sfc",
    "astro",
    "documentation-integrity",
    "spec-driven-development"
  ],
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "build": "bun build ./src/cli/index.ts --target bun --outfile ./dist/verity.js --external @vue/compiler-sfc --external @modelcontextprotocol/sdk && bun build ./src/index.ts --target bun --outfile ./dist/index.js --external @vue/compiler-sfc --external @modelcontextprotocol/sdk",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun test",
    "check": "bun run src/cli/index.ts check",
    "link": "bun run src/cli/index.ts link",
    "init": "bun run src/cli/index.ts init",
    "mcp": "bun run src/cli/index.ts mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vue/compiler-sfc": "^3.5.13",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^22.13.5"
  }
}
